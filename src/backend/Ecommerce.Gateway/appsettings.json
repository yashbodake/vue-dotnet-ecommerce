{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api-cluster",
        "Order": 0,
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "vue": {
        "ClusterId": "vue-cluster",
        "Order": 1,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "api": {
            "Address": "http://127.0.0.1:5100"
          }
        }
      },
      "vue-cluster": {
        "Destinations": {
          "vue": {
            "Address": "http://127.0.0.1:5173"
          }
        }
      }
    }
  }
}
