@model IEnumerable<Ecommerce.Core.Models.Order>
@{
    ViewBag.Title = "Admin — Orders";
    var statuses = ViewBag.Statuses as string[] ?? new string[0];
    var selected = ViewBag.SelectedStatus as string;
}

<section class="admin-page">
    <div class="admin-header">
        <h1>Orders</h1>
        <a class="btn" href="@Url.Action("Products")" style="background:#667085">Products</a>
    </div>

    @if (TempData["AdminMessage"] != null)
    {
        <div class="admin-ok">@TempData["AdminMessage"]</div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="checkout-alert">@TempData["AdminError"]</div>
    }

    <form method="get" class="admin-filter" action="@Url.Action("Orders")">
        <label>
            Status
            <select name="status" class="form-control" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var s in statuses)
                {
                    <option value="@s" @(string.Equals(selected, s, StringComparison.OrdinalIgnoreCase) ? "selected" : null)>@s</option>
                }
            </select>
        </label>
    </form>

    <table class="cart-table" id="admin-orders">
        <thead>
            <tr>
                <th>Order</th>
                <th>Date</th>
                <th>User</th>
                <th>Total</th>
                <th>Status</th>
                <th>Update</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>#@o.OrderId</td>
                    <td>@o.OrderDate.ToString("g")</td>
                    <td class="muted">@o.UserId</td>
                    <td>@o.TotalAmount.ToString("C")</td>
                    <td>@o.Status</td>
                    <td>
                        @using (Html.BeginForm("UpdateOrderStatus", "Admin", FormMethod.Post, new { @class = "inline-form admin-status-form" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@o.OrderId" />
                            <input type="hidden" name="filterStatus" value="@selected" />
                            <select name="status" class="form-control admin-status-select">
                                @foreach (var s in statuses)
                                {
                                    <option value="@s" @(string.Equals(o.Status, s, StringComparison.OrdinalIgnoreCase) ? "selected" : null)>@s</option>
                                }
                            </select>
                            <button type="submit" class="btn">Save</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>

@section Scripts {
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script>
$(function () {
    if ($.fn.DataTable) {
        $('#admin-orders').DataTable({ order: [[1, 'desc']], pageLength: 10 });
    }
});
</script>
}
