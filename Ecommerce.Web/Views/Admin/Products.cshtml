@model IEnumerable<Ecommerce.Core.Models.Product>
@{
    ViewBag.Title = "Admin — Products";
}

<section class="admin-page">
    <div class="admin-header">
        <h1>Products</h1>
        <a class="btn" href="@Url.Action("CreateProduct")">Create product</a>
    </div>

    @if (TempData["AdminMessage"] != null)
    {
        <div class="admin-ok">@TempData["AdminMessage"]</div>
    }
    @if (TempData["AdminError"] != null)
    {
        <div class="checkout-alert">@TempData["AdminError"]</div>
    }

    <p class="muted">
        <a href="@Url.Action("Orders")">Orders</a>
    </p>

    <table class="cart-table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr class="@(p.IsActive ? "" : "admin-inactive")">
                    <td>@p.ProductId</td>
                    <td>@p.Name</td>
                    <td>@p.CategoryName</td>
                    <td>@p.Price.ToString("C")</td>
                    <td>@p.Stock</td>
                    <td>@(p.IsActive ? "Yes" : "No")</td>
                    <td class="admin-row-actions">
                        <a href="@Url.Action("EditProduct", new { id = p.ProductId })">Edit</a>
                        @if (p.IsActive)
                        {
                            using (Html.BeginForm("DeleteProduct", "Admin", new { id = p.ProductId }, FormMethod.Post, new { @class = "inline-form", onsubmit = "return confirm('Soft-delete this product?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="link-button">Deactivate</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>
