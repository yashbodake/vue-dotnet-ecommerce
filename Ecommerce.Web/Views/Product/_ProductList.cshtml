@model Ecommerce.Core.Models.PagedResult<Ecommerce.Core.Models.Product>

@if (Model == null || Model.Items == null || Model.Items.Count == 0)
{
    <p class="muted">No products match your filters.</p>
}
else
{
    <p class="result-meta">Showing @Model.Items.Count of @Model.TotalCount products (page @Model.Page of @Model.TotalPages)</p>
    <div class="product-grid">
        @foreach (var product in Model.Items)
        {
            @Html.Partial("_ProductCard", product)
        }
    </div>
    @Html.Partial("_Pagination", Model)
}
