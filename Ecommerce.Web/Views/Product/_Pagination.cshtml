@model Ecommerce.Core.Models.PagedResult<Ecommerce.Core.Models.Product>

@if (Model != null && Model.TotalPages > 1)
{
    <nav class="pager" aria-label="Product pagination">
        @if (Model.HasPreviousPage)
        {
            <a href="#" class="pager-link" data-page="@(Model.Page - 1)">Previous</a>
        }

        @for (var i = 1; i <= Model.TotalPages; i++)
        {
            if (i == Model.Page)
            {
                <span class="pager-current">@i</span>
            }
            else
            {
                <a href="#" class="pager-link" data-page="@i">@i</a>
            }
        }

        @if (Model.HasNextPage)
        {
            <a href="#" class="pager-link" data-page="@(Model.Page + 1)">Next</a>
        }
    </nav>
}
