@model Ecommerce.Web.ViewModels.ProductIndexViewModel
@{
    ViewBag.Title = "Catalog";
}

<div class="catalog-layout">
    <aside class="catalog-filters">
        <h2>Filters</h2>
        <form id="filter-form" method="get" action="@Url.Action("Filter", "Product")">
            <input type="hidden" name="Page" id="filter-page" value="1" />

            <fieldset>
                <legend>Category</legend>
                @foreach (var category in Model.Categories)
                {
                    <label class="filter-check">
                        <input type="checkbox" name="CategoryIds" value="@category.CategoryId" />
                        @category.Name
                    </label>
                }
            </fieldset>

            <fieldset>
                <legend>Price</legend>
                <label>
                    Min
                    <input type="number" name="MinPrice" step="0.01" min="0" placeholder="0" />
                </label>
                <label>
                    Max
                    <input type="number" name="MaxPrice" step="0.01" min="0" placeholder="999" />
                </label>
            </fieldset>

            <fieldset>
                <legend>Availability</legend>
                <label class="filter-check">
                    <input type="checkbox" name="InStockOnly" value="true" />
                    In stock only
                </label>
            </fieldset>

            <fieldset>
                <legend>Sort</legend>
                <select name="SortBy">
                    <option value="name">Name</option>
                    <option value="price_asc">Price: Low to High</option>
                    <option value="price_desc">Price: High to Low</option>
                    <option value="newest">Newest</option>
                </select>
            </fieldset>

            <fieldset>
                <legend>Search</legend>
                <input type="text" name="Search" placeholder="Search products..." />
            </fieldset>

            <input type="hidden" name="PageSize" value="12" />
        </form>
    </aside>

    <section class="catalog-results">
        <h1>Products</h1>
        <div id="product-grid">
            @Html.Partial("_ProductList", Model.InitialResults)
        </div>
    </section>
</div>

@section Scripts {
<script>
$(function () {
    function loadProducts(page) {
        if (page) {
            $('#filter-page').val(page);
        }
        $.get('@Url.Action("Filter", "Product")', $('#filter-form').serialize(), function (html) {
            $('#product-grid').html(html);
        });
    }

    $('#filter-form').on('change', 'input, select', function () {
        loadProducts(1);
    });

    // Debounce search typing
    var searchTimer;
    $('#filter-form').on('keyup', 'input[name="Search"]', function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(function () { loadProducts(1); }, 300);
    });

    $(document).on('click', '.pager-link', function (e) {
        e.preventDefault();
        var page = $(this).data('page');
        loadProducts(page);
    });
});
</script>
}
