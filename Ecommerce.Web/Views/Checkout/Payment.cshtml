@model Ecommerce.Web.Models.CheckoutViewModel
@{
    ViewBag.Title = "Checkout — Payment";
    var cart = ViewBag.Cart as Ecommerce.Core.ViewModels.CartViewModel;
}

<section class="checkout-page">
    @Html.Partial("_Steps", Model)

    @if (TempData["CheckoutError"] != null)
    {
        <div class="checkout-alert">@TempData["CheckoutError"]</div>
    }

    <div class="checkout-layout">
        <div class="account-panel">
            <h1>Payment</h1>
            <p class="muted">Demo checkout only - no real card charges.</p>
            <p class="muted">Ship via <strong>@(Model.ShippingMethod == "Express" ? "Express (1-2 days)" : "Standard (3-5 days)")</strong> to @Model.FormattedShippingAddress</p>

            @using (Html.BeginForm("PlaceOrder", "Checkout", FormMethod.Post, new { id = "checkout-payment-form", @class = "account-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    @Html.LabelFor(m => m.CardName)
                    @Html.TextBoxFor(m => m.CardName, new { @class = "form-control", autocomplete = "cc-name" })
                    @Html.ValidationMessageFor(m => m.CardName, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.CardNumber)
                    @Html.TextBoxFor(m => m.CardNumber, new { @class = "form-control", autocomplete = "cc-number", placeholder = "4111 1111 1111 1111" })
                    @Html.ValidationMessageFor(m => m.CardNumber, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.CardExpiry)
                    @Html.TextBoxFor(m => m.CardExpiry, new { @class = "form-control", autocomplete = "cc-exp", placeholder = "12/28" })
                    @Html.ValidationMessageFor(m => m.CardExpiry, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.CardCvv)
                    @Html.TextBoxFor(m => m.CardCvv, new { @class = "form-control", autocomplete = "cc-csc", placeholder = "123" })
                    @Html.ValidationMessageFor(m => m.CardCvv, "", new { @class = "text-danger" })
                </div>

                <div class="cart-actions">
                    <a href="@Url.Action("Shipping")" class="btn" style="background:#667085">Back</a>
                    <button type="submit" class="btn">Place order</button>
                </div>
            }
        </div>

        @Html.Partial("_OrderSummary", cart)
    </div>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
