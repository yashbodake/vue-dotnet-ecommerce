@model Ecommerce.Core.Models.Order
@{
    ViewBag.Title = "Order confirmed";
}

<section class="account-panel">
    <h1>Thank you!</h1>
    <p>Your order <strong>#@Model.OrderId</strong> has been placed.</p>
    <p class="muted">Status: @Model.Status · Total: @Model.TotalAmount.ToString("C")</p>
    <p>We'll ship to: @Model.ShippingAddress</p>

    <div class="cart-actions">
        <a class="btn" href="@Url.Action("OrderDetail", "Account", new { id = Model.OrderId })">View order</a>
        <a class="btn" href="@Url.Action("Index", "Product")" style="background:#667085">Continue shopping</a>
    </div>
</section>
