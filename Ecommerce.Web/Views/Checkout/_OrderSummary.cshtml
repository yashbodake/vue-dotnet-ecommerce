@model Ecommerce.Core.ViewModels.CartViewModel
@{
    var cart = Model ?? ViewBag.Cart as Ecommerce.Core.ViewModels.CartViewModel;
}
@if (cart != null && cart.Lines != null && cart.Lines.Count > 0)
{
    <aside class="checkout-summary">
        <h3>Order summary</h3>
        <ul>
            @foreach (var line in cart.Lines)
            {
                <li>
                    <span>@line.ProductName × @line.Quantity</span>
                    <strong>@line.LineTotal.ToString("C")</strong>
                </li>
            }
        </ul>
        <p class="checkout-summary-total">Total: <strong>@cart.Total.ToString("C")</strong></p>
    </aside>
}
