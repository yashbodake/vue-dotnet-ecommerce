<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Legacy Ecommerce</title>
    @Styles.Render("~/Content/css")
    @RenderSection("Styles", required: false)
</head>
<body>
    @Html.AntiForgeryToken()
    <header class="site-header">
        <div class="site-brand">
            <a href="@Url.Action("Index", "Product")">Legacy Ecommerce</a>
        </div>
        <nav class="site-nav">
            <a href="@Url.Action("Index", "Product")">Catalog</a>
            <a href="@Url.Action("Index", "Cart")">Cart</a>
            <span id="mini-cart-container">@Html.Partial("_MiniCart", (int)(ViewBag.MiniCartCount ?? 0))</span>
            @if (Request.IsAuthenticated)
            {
                if (User.IsInRole("Admin"))
                {
                    <a href="@Url.Action("Products", "Admin")">Admin</a>
                }
                <a href="@Url.Action("Orders", "Account")">My Orders</a>
                <span class="nav-user">@User.Identity.Name</span>
                using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { @class = "inline-form" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="link-button">Log off</button>
                }
            }
            else
            {
                <a href="@Url.Action("Register", "Account")">Register</a>
                <a href="@Url.Action("Login", "Account")">Log in</a>
            }
        </nav>
    </header>
    <main class="site-main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <p>.NET Framework 4.7.2 · ASP.NET MVC 5 · Spec-driven build</p>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script>
        var token = $('input[name="__RequestVerificationToken"]').val();
        if (token) {
            $.ajaxSetup({
                headers: { 'RequestVerificationToken': token }
            });
        }
    </script>
    @Scripts.Render("~/bundles/site")
    @RenderSection("Scripts", required: false)
</body>
</html>
